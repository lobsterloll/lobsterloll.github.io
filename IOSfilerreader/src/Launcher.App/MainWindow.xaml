<Window x:Class="XboxLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Xbox Universal Launcher" Width="1120" Height="780" MinWidth="850" MinHeight="600" Background="#F3F5F3">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Xbox Universal Launcher" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Play Xbox ISO games on your PC · Original Xbox + Xbox 360" Foreground="#4B6050" Margin="0,6,0,0"/></StackPanel>
  <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,12"><Button Content="Open ISO &amp; Play…" Click="OpenPlay_Click"/><Button Content="Add games…" Click="Import_Click"/><Button Content="Remove from library" Click="Remove_Click"/><Button Content="Emulator settings…" Click="Configure_Click"/><Button Content="Play selected" Click="Launch_Click"/><Button Content="Game saves" Click="Saves_Click"/><Button Content="Performance optimizer" Click="Optimize_Click"/></WrapPanel>
  <DataGrid x:Name="Games" Grid.Row="2" SelectionChanged="Games_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Console" Binding="{Binding Console}" Width="140"/><DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="210"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="3" Margin="0,14"><TextBlock x:Name="Details" Text="Click Open ISO &amp; Play to choose a game. Xbox One / Series: unsupported." TextWrapping="Wrap"/><TextBlock x:Name="ImagePath" Margin="0,5,0,0" Foreground="#526157" TextWrapping="Wrap"/></StackPanel>
  <Expander Grid.Row="4" Header="Game ISO file details (optional)"><DataGrid x:Name="Files" Height="220"><DataGrid.Columns><DataGridTextColumn Header="File inside ISO" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Bytes" Binding="{Binding Size}" Width="120"/><DataGridCheckBoxColumn Header="Folder" Binding="{Binding IsDirectory}" Width="70"/><DataGridTextColumn Header="ISO offset" Binding="{Binding Offset}" Width="130"/></DataGrid.Columns></DataGrid></Expander>
  <TextBlock x:Name="Status" Grid.Row="5" Margin="0,14,0,0" TextWrapping="Wrap" Text="Choose your game ISO to play through xemu or Xenia. On first play, select the required emulator executable."/>
 </Grid>
</Window>
