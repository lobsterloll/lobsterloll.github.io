# Requires Clik2pay merchant approval and integration testing. No account is created by this file.
# Copy to .env on your HTTPS payment server. Never put real secrets in the EXE.
PORT=8080
PUBLIC_URL=https://payments.example.com
INTERAC_MODE=sandbox
CLIK2PAY_USERNAME=
CLIK2PAY_PASSWORD=
CLIK2PAY_API_KEY=
CLIK2PAY_MERCHANT_ID=
CLIK2PAY_WEBHOOK_USER=
CLIK2PAY_WEBHOOK_PASSWORD=
LICENSE_PRIVATE_KEY_PATH=./private/license-private.pem
DATABASE_PATH=./data/interac.sqlite
# The final customer price is fixed in code: CAD 3.00, tax included.
