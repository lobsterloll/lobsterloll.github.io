<Window x:Class="KeyboardWarrior.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Warrior" Width="300" Height="280" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Keyboard Warrior" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
        <CheckBox x:Name="LockCheck" Content="Lock position" Margin="0,0,0,16"
                  Checked="LockChanged" Unchecked="LockChanged" />
        <TextBlock Text="Character size" />
        <Slider x:Name="SizeSlider" Minimum="50" Maximum="200" ValueChanged="OnSizeChanged"
                TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,4,0,12" />
        <TextBlock Text="Opacity" />
        <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" ValueChanged="OpacityChanged"
                TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="VisibilityButton" Content="Hide Character" Width="120"
                    Margin="0,0,8,0" Click="VisibilityClicked" />
            <Button Content="Exit" Width="60" Click="ExitClicked" />
        </StackPanel>
    </StackPanel>
</Window>
