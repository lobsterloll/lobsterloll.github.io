<Window x:Class="KeyboardWarrior.CharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" SizeToContent="Manual"
        MouseLeftButtonDown="StartDrag" LocationChanged="PositionChanged">
    <Viewbox Stretch="Fill">
        <Canvas Width="250" Height="266.5" Background="Transparent">
            <Image Source="/Assets/body.png" Width="215.5" Height="266.5"
                   Canvas.Left="35" />
            <Canvas x:Name="LeftArm" Width="70.19" Height="32.53"
                    Canvas.Left="21" Canvas.Top="200" Panel.ZIndex="2">
                <Canvas.RenderTransform>
                    <MatrixTransform x:Name="LeftMotion" />
                </Canvas.RenderTransform>
                <Path Data="M 70,9 L 31,9 C 25,4 20,3 15,4 C 6,4 2,9 2,16 C 2,24 8,29 16,29 C 23,29 27,26 31,23 L 70,23 Z"
                      Fill="#8BF18B" />
                <Path Data="M 70,9 L 31,9 C 25,4 20,3 15,4 C 6,4 2,9 2,16 C 2,24 8,29 16,29 C 23,29 27,26 31,23 L 70,23"
                      Stroke="#151515" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 10,13 C 13,10 18,12 18,16 C 18,20 12,22 9,18 C 8,16 8,15 10,13 Z" Fill="#4DBB60" />
                <Ellipse Canvas.Left="8" Canvas.Top="9" Width="3.5" Height="3.5" Fill="#4DBB60" />
                <Ellipse Canvas.Left="16" Canvas.Top="8" Width="3.5" Height="3.5" Fill="#4DBB60" />
            </Canvas>
            <Canvas x:Name="RightArm" Width="82" Height="31.68"
                    Canvas.Left="90" Canvas.Top="198" Panel.ZIndex="2">
                <Canvas.RenderTransform>
                    <MatrixTransform x:Name="RightMotion" />
                </Canvas.RenderTransform>
                <Path Data="M 82,9 L 31,9 C 25,4 20,3 15,4 C 6,4 2,9 2,16 C 2,24 8,29 16,29 C 23,29 27,26 31,23 L 82,23 Z"
                      Fill="#8BF18B" />
                <Path Data="M 82,9 L 31,9 C 25,4 20,3 15,4 C 6,4 2,9 2,16 C 2,24 8,29 16,29 C 23,29 27,26 31,23 L 82,23"
                      Stroke="#151515" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 10,13 C 13,10 18,12 18,16 C 18,20 12,22 9,18 C 8,16 8,15 10,13 Z" Fill="#4DBB60" />
                <Ellipse Canvas.Left="8" Canvas.Top="9" Width="3.5" Height="3.5" Fill="#4DBB60" />
                <Ellipse Canvas.Left="16" Canvas.Top="8" Width="3.5" Height="3.5" Fill="#4DBB60" />
            </Canvas>
            <Canvas Width="160" Height="60" Canvas.Left="0" Canvas.Top="203" Panel.ZIndex="1">
                <Path Data="M 1,22 L 142,47 L 142,53 L 1,28 Z"
                      Fill="#B8B8B8" Stroke="#989898" StrokeThickness="1" />
                <Path Data="M 142,47 L 152,25 L 152,31 L 142,53 Z"
                      Fill="#909090" Stroke="#777777" StrokeThickness="1" />
                <Image Source="/Assets/keyboard.png" Width="128.61" Height="51.14">
                    <Image.RenderTransform>
                        <MatrixTransform Matrix="1.1,0.195,-0.19,0.43,11,0" />
                    </Image.RenderTransform>
                </Image>
            </Canvas>
            <Canvas x:Name="Mouse" Width="108.61" Height="31.68"
                    Canvas.Left="152" Canvas.Top="234" Panel.ZIndex="3" Visibility="Collapsed">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="MouseMotion" />
                </Canvas.RenderTransform>
                <Path Data="M 36,2 C 28,2 23,8 23,16 L 23,21 C 23,27 28,30 36,30 C 45,30 50,26 50,20 L 50,14 C 50,7 44,2 36,2 Z"
                      Fill="#C8C8C8" Stroke="#151515" StrokeThickness="2.5" />
                <Path Data="M 25,20 C 30,24 43,25 48,21" Stroke="#929292" StrokeThickness="2" />
                <Path Data="M 36,3 L 36,12" Stroke="#555555" StrokeThickness="1.5" />
                <Path Data="M 36,11 L 36,16" Stroke="#151515" StrokeThickness="3" StrokeStartLineCap="Round" />
                <Ellipse Canvas.Left="29" Canvas.Top="7" Width="4" Height="6" Fill="#FFFFFF" Opacity="0.5" />
            </Canvas>
        </Canvas>
    </Viewbox>
</Window>
